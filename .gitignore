# Dependencies
node_modules/
**/node_modules/

# Package manager (pnpm monorepo)
pnpm-lock.yaml

# Build outputs
dist/
build/
**/dist/
**/build/

# Vite cache
.vite/
.cache/
**/.vite/
**/.cache/

# Turbo cache
.turbo/

# Environment files (real values never committed)
.env
.env.local
.env.*
**/.env
**/.env.local
**/.env.*

# Environment templates are safe to commit (re-included after the ignores above)
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Cache & Temp
.tmp/
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db
**/Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
