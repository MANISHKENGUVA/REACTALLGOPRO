{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "VITE_API_BASE_URL",
    "VITE_APP_ENV",
    "VITE_APP_NAME",
    "VITE_APP_THEME",
    "VITE_NEON_API_URL",
    "VITE_WORKFLOW_SESSION_URL",
    "VITE_WORKFLOW_RECOVER_URL",
    "VITE_WORKFLOW_SESSION_REVOKE_URL",
    "VITE_WORKFLOW_RECOVERY_START_URL",
    "VITE_WORKFLOW_RECOVERY_OTP_REQUEST_URL",
    "VITE_WORKFLOW_RECOVERY_OTP_VERIFY_URL",
    "VITE_WORKFLOW_RECOVERY_COMPLETE_URL",
    "VITE_WORKFLOW_RESOLVE_URL",
    "VITE_WORKFLOW_EVENT_URL",
    "VITE_AUTH_VERIFY_URL",
    "VITE_CAPTCHA_VERIFY_URL",
    "VITE_CAPTCHA_CONFIG_URL",
    "VITE_WORKFLOW_BOOTSTRAP_URL",
    "VITE_WORKFLOW_EVENT_LEGACY_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint": {},
    "test": {}
  }
}